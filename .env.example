# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# ---- Application ----
# Port the server binds to. Hosting platforms usually inject this.
PORT=8000
# Interface to bind. Use 127.0.0.1 for local-only, 0.0.0.0 inside containers.
HOST=127.0.0.1
# Set to any value to enable uvicorn auto-reload during development.
DEV=

# ---- Deployment helper (optional, local use only) ----
# Hugging Face "Write" access token.
HF_TOKEN=
# Your Hugging Face account or organisation name.
HF_OWNER=
# Target Space name.
HF_SPACE=kamuflaj
